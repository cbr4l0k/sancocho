# Public Convex deployment URL. Copy it from the Convex dashboard or CLI output
# for the deployment whose auth.config.ts uses your Clerk issuer.
NEXT_PUBLIC_CONVEX_URL=

# Public Clerk key from the Clerk Dashboard's API Keys page. This is safe for the
# browser and is required by @clerk/nextjs.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# A Clerk secret key is NOT needed by this client-only shell. Add CLERK_SECRET_KEY
# only when a later issue introduces server-side Clerk usage; never expose it as
# a NEXT_PUBLIC_ variable.
