node_modules/
.DS_Store
coverage/
*.tsbuildinfo

# Convex generated API and data-model types are committed so source imports work
# immediately after checkout. Local deployment metadata and environment files are not.
apps/convex/.env.local
apps/convex/convex/.env.local
apps/web/.env*.local
apps/convex/convex/_generated/.cache/

# Next.js build output. `apps/web/next-env.d.ts` is deliberately NOT ignored:
# `bun run typecheck` must pass on a fresh checkout without a build first, the
# same reason the Convex generated API is committed.
apps/web/.next/
apps/web/out/

# Agent worktrees created by Claude Code.
.claude/worktrees/

# Task briefs, agent reports and run logs handed to delegated coding agents.
# Working material for one issue, not a record of the decision — what mattered
# ends up in the issue comment, docs/deviations.md, or a comment in the code.
.briefs/
